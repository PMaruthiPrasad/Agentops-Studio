# ---------------------------------------------------------------------------
# AgentOps Studio — environment
#
# Copy to `.env` and adjust. Every value below has a working default, so the
# app runs end to end with an EMPTY .env file. No API keys required.
# ---------------------------------------------------------------------------

# SQLite connection string used by Prisma.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# LLM providers (all optional)
#
# Leave these unset to run entirely on the deterministic MockProvider.
# If credentials ARE present, the matching provider becomes available and any
# node configured to use it will hit the real API. Nodes always fall back to
# the mock provider when their requested provider has no credentials.
# ---------------------------------------------------------------------------

# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_DEFAULT_MODEL="gpt-4o-mini"

# ANTHROPIC_API_KEY=""
# ANTHROPIC_BASE_URL="https://api.anthropic.com"
# ANTHROPIC_DEFAULT_MODEL="claude-opus-5"

# Google Vertex AI — no API key. Authentication is by Application Default
# Credentials, so run ONE of:
#   gcloud auth application-default login          (local development)
#   GOOGLE_APPLICATION_CREDENTIALS=/path/key.json  (service account)
# ...or nothing at all on GCP, where the metadata server supplies them.
#
# The project id is what marks this provider as configured; without it the
# app falls back to the mock exactly as it does for a missing API key.
# GOOGLE_CLOUD_PROJECT=""
# GOOGLE_CLOUD_LOCATION="us-central1"
# GOOGLE_DEFAULT_MODEL="gemini-3.6-flash"   # $0.75 / $3.75 per 1M in / out tokens.
#   A model missing from MODEL_PRICING is costed at the fallback rate, not its own.
# GOOGLE_VERTEX_BASE_URL=""

# Provider used when a node does not specify one.
# One of: none | mock | openai | anthropic | google
# `none` is an explicit opt-out that runs everything on the mock, even when
# real credentials are present — useful for demoing without spending.
DEFAULT_LLM_PROVIDER="mock"

# ---------------------------------------------------------------------------
# Execution engine tuning
# ---------------------------------------------------------------------------

# Max nodes executed concurrently within a single parallel layer.
ENGINE_MAX_CONCURRENCY="4"

# Default retry attempts per node (1 = no retry).
ENGINE_MAX_ATTEMPTS="3"

# Hard ceiling on a single node's wall-clock time, in milliseconds.
ENGINE_NODE_TIMEOUT_MS="60000"

# ---------------------------------------------------------------------------
# MockProvider realism controls
# ---------------------------------------------------------------------------

# Scales simulated latency. 0 makes runs instant (used by the test suite).
MOCK_LATENCY_FACTOR="1"

# Probability (0..1) that a mock call fails, to exercise the retry path.
MOCK_FAILURE_RATE="0.04"
