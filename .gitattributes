# Normalise line endings: the repo stores LF, checkouts get the platform default.
# Without this, a Windows clone rewrites every file and the first diff is noise.
* text=auto eol=lf

# Binary-ish files git should never try to normalise.
*.png binary
*.jpg binary
*.ico binary
*.db binary
*.woff binary
*.woff2 binary

# Generated — collapse in diffs and exclude from language stats.
package-lock.json linguist-generated=true -diff
